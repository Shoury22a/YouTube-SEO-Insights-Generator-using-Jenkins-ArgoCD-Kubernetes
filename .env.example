# ── API Keys ──────────────────────────────────────────────────────────────────
# Get yours at https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Add more keys to rotate through them (Multi-Key Rotation)
# GOOGLE_API_KEY_2=your_second_gemini_key_here

# Groq API Key for ultimate fallback (Llama 3.3 70B)
# Get yours at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── LangSmith Tracing (Optional) ──────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tuberank-seo-agent

# ── RAGAS RAG Evaluation (Optional) ───────────────────────────────────────────
RAGAS_EVALUATION_ENABLED=false
